# Copy this file to .env and fill in real values for local development.
# On Heroku, DATABASE_URL is set automatically the moment you add the
# Heroku Postgres add-on — you don't need to set it by hand there.

DATABASE_URL="postgresql://user:password@localhost:5432/fits_me_right"

# Comma-separated list of origins allowed to call this API (your deployed
# site + local dev). No trailing slashes.
CORS_ORIGINS="http://localhost:5180,https://fits-me-right.cmarshboy123.workers.dev"

PORT=3000
