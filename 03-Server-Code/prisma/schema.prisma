// Fits Me Right catalog database schema.
// Mirrors the product shape the frontend already expects (see
// 01-Site-Code/src/services/catalogService.js) so swapping the data
// source doesn't require touching search/filter logic on the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  // Autoincrement so the database assigns ids atomically. The route used to
  // read MAX(id) and insert with id+1 in two separate steps — safe for one
  // request at a time, but two concurrent POSTs could read the same max and
  // both try to insert the same id, so one would fail. A DB-native sequence
  // can't race like that.
  id       Int    @id @default(autoincrement())
  name     String
  gender   String
  category String
  price    Float
  priceTier String
  imageUrl String
  vendor   String
  brand    String
  color    String
  storeTier String

  bodyType  String[]
  dressCode String[]

  availableShirtSizes String[]
  availablePantsSizes String[]

  // Only set on items with a hand-verified exact retailer link.
  productUrl String?
  verifiedAt String?
  fitNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gender])
  @@index([category])
  @@index([vendor])
  @@index([priceTier])
}

// Caches live web search results (SerpApi / Google Shopping) per normalized
// query so repeat searches for the same term don't spend API quota, which is
// capped by plan (as low as 250 searches/month on the free tier).
model LiveSearchCache {
  query     String   @id
  results   Json
  createdAt DateTime @default(now())
}
